{
  "name": "runtpt-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev": "npm run dev -w @runtpt/web",
    "embed": "node scripts/embed-web.mjs",
    "prepare": "node scripts/embed-web.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
